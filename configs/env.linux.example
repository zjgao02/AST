# Source this file on the Linux/GPU server after editing the paths:
#   set -a; source configs/env.linux.example; set +a

ASTEVOLVE_PROJECT_ROOT=/srv/astevolve/ast
ASTEVOLVE_DATA_ROOT=${ASTEVOLVE_PROJECT_ROOT}/data
ASTEVOLVE_ARTIFACT_ROOT=${ASTEVOLVE_PROJECT_ROOT}/artifacts
ASTEVOLVE_MODEL_ROOT=${ASTEVOLVE_PROJECT_ROOT}/model_weights
ASTEVOLVE_TMP_ROOT=${ASTEVOLVE_ARTIFACT_ROOT}/tmp

ASTEVOLVE_PROGEN_MODEL_DIR=${ASTEVOLVE_MODEL_ROOT}/progen2-small
ASTEVOLVE_PROTENIX_ROOT=${ASTEVOLVE_MODEL_ROOT}/protenix
ASTEVOLVE_PROTENIX_TMP=${ASTEVOLVE_TMP_ROOT}/protenix
ASTEVOLVE_PROTENIX_NUM_WORKERS=1
ASTEVOLVE_PROTENIX_TIMEOUT=1800

ASTEVOLVE_LLM_API_BASE=
ASTEVOLVE_LLM_API_KEY=
